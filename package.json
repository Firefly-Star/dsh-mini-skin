{
  "name": "dsh-mini-skin",
  "version": "0.3.1",
  "description": "Stylesheet-only DSH skin: background art, palette tokens, square UI contract, fonts - all in one settings section. No observers, no DOM surgery.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "assets/plugin-icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "locale/*.json",
    "assets/plugin-icon.svg",
    "artwork",
    "README.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.3.0-0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Firefly-Star/dsh-mini-skin.git"
  },
  "homepage": "https://github.com/Firefly-Star/dsh-mini-skin#readme",
  "bugs": {
    "url": "https://github.com/Firefly-Star/dsh-mini-skin/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "skin",
    "theme",
    "plugin"
  ],
  "author": "Firefly-Star"
}
